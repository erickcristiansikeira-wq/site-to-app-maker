
import { useEffect, useRef, useState } from "react";

type Frame = {
  id: string;
  url: string;
};

export default function SpriteAnimationEditor() {
  const [frames, setFrames] = useState<Frame[]>([]);
  const [selected, setSelected] = useState(0);
  const [width, setWidth] = useState(32);
  const [height, setHeight] = useState(32);
  const [fps, setFps] = useState(8);
  const [playing, setPlaying] = useState(false);
  const [message, setMessage] = useState(
    "Importe uma spritesheet PNG para começar."
  );

  const sheetInput = useRef<HTMLInputElement>(null);
  const frameInput = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (!playing || frames.length < 2) return;

    const timer = window.setInterval(() => {
      setSelected((current) => (current + 1) % frames.length);
    }, 1000 / fps);

    return () => window.clearInterval(timer);
  }, [playing, frames.length, fps]);

  function importSheet(file?: File) {
    if (!file) return;

    const image = new Image();
    const url = URL.createObjectURL(file);

    image.onload = () => {
      const cols = Math.floor(image.width / width);
      const rows = Math.floor(image.height / height);

      if (!cols || !rows) {
        URL.revokeObjectURL(url);
        setMessage("Dimensões dos frames inválidas para esta imagem.");
        return;
      }

      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const result: Frame[] = [];

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          ctx.clearRect(0, 0, width, height);
          ctx.drawImage(
            image,
            x * width,
            y * height,
            width,
            height,
            0,
            0,
            width,
            height
          );

          result.push({
            id: `${x}-${y}-${Date.now()}-${result.length}`,
            url: canvas.toDataURL("image/png"),
          });
        }
      }

      setFrames(result);
      setSelected(0);
      setPlaying(false);
      setMessage(`Importados ${result.length} frames.`);
      URL.revokeObjectURL(url);
    };

    image.onerror = () => {
      URL.revokeObjectURL(url);
      setMessage("Não foi possível abrir a imagem.");
    };

    image.src = url;
  }

  function replaceFrame(file?: File) {
    if (!file || !frames[selected]) return;

    const image = new Image();
    const url = URL.createObjectURL(file);

    image.onload = () => {
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(image, 0, 0, width, height);

      const newUrl = canvas.toDataURL("image/png");

      setFrames((current) =>
        current.map((frame, index) =>
          index === selected ? { ...frame, url: newUrl } : frame
        )
      );

      setMessage(`Frame ${selected + 1} substituído.`);
      URL.revokeObjectURL(url);
    };

    image.onerror = () => {
      URL.revokeObjectURL(url);
      setMessage("Não foi possível abrir a imagem escolhida.");
    };

    image.src = url;
  }

  async function exportSheet() {
    if (!frames.length) return;

    const canvas = document.createElement("canvas");
    canvas.width = width * frames.length;
    canvas.height = height;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    try {
      for (let i = 0; i < frames.length; i++) {
        const image = new Image();
        image.src = frames[i].url;

        await new Promise<void>((resolve, reject) => {
          image.onload = () => resolve();
          image.onerror = () => reject();
        });

        ctx.drawImage(image, i * width, 0, width, height);
      }

      const link = document.createElement("a");
      link.download = "spritesheet-editada.png";
      link.href = canvas.toDataURL("image/png");
      link.click();

      setMessage("Spritesheet PNG exportada com sucesso.");
    } catch {
      setMessage("Falha ao exportar a spritesheet.");
    }
  }

  const currentFrame = frames[selected];

  return (
    <main className="mx-auto w-full max-w-5xl space-y-5 p-4 text-foreground">
      <header>
        <h1 className="text-2xl font-bold">
          Editor de Animações de Sprites GBA
        </h1>
        <p className="text-sm text-muted-foreground">
          Edite e visualize frames de spritesheets Pokémon.
        </p>
      </header>

      <section className="space-y-3 rounded-xl border p-4">
        <h2 className="font-semibold">1. Importar spritesheet</h2>

        <div className="grid grid-cols-2 gap-3">
          <label>
            Largura (px)
            <input
              className="mt-1 w-full rounded border bg-background p-2"
              type="number"
              min="1"
              max="512"
              value={width}
              onChange={(e) => setWidth(Math.max(1, Number(e.target.value)))}
            />
          </label>

          <label>
            Altura (px)
            <input
              className="mt-1 w-full rounded border bg-background p-2"
              type="number"
              min="1"
              max="512"
              value={height}
              onChange={(e) => setHeight(Math.max(1, Number(e.target.value)))}
            />
          </label>
        </div>

        <input
          ref={sheetInput}
          hidden
          type="file"
          accept="image/png,image/*"
          onChange={(e) => importSheet(e.target.files?.[0])}
        />

        <button
          className="rounded-lg bg-primary px-4 py-2 text-primary-foreground"
          onClick={() => sheetInput.current?.click()}
        >
          Escolher imagem
        </button>
      </section>

      <section className="space-y-3 rounded-xl border p-4">
        <h2 className="font-semibold">2. Animação</h2>

        <div className="flex flex-wrap gap-2">
          <button
            className="rounded-lg border px-3 py-2"
            disabled={frames.length < 2}
            onClick={() => setPlaying((value) => !value)}
          >
            {playing ? "Pausar" : "Reproduzir"}
          </button>

          <button
            className="rounded-lg border px-3 py-2"
            disabled={!frames.length}
            onClick={() => {
              setPlaying(false);
              setSelected((value) => Math.max(0, value - 1));
            }}
          >
            ← Anterior
          </button>

          <button
            className="rounded-lg border px-3 py-2"
            disabled={!frames.length}
            onClick={() => {
              setPlaying(false);
              setSelected((value) => (value + 1) % frames.length);
            }}
          >
            Próximo →
          </button>
        </div>

        <label className="block">
          Velocidade: {fps} FPS
          <input
            className="block w-full"
            type="range"
            min="1"
            max="30"
            value={fps}
            onChange={(e) => setFps(Number(e.target.value))}
          />
        </label>

        <div className="flex min-h-48 items-center justify-center rounded-lg border bg-muted p-4">
          {currentFrame ? (
            <img
              src={currentFrame.url}
              alt={`Frame ${selected + 1}`}
              style={{
                width: Math.max(96, width * 4),
                height: Math.max(96, height * 4),
                maxWidth: "100%",
                objectFit: "contain",
                imageRendering: "pixelated",
              }}
            />
          ) : (
            <p className="text-sm text-muted-foreground">
              A animação aparecerá aqui.
            </p>
          )}
        </div>

        <p className="text-sm">
          {frames.length
            ? `Frame ${selected + 1} de ${frames.length}`
            : "Nenhum frame carregado"}
        </p>
      </section>

      <section className="space-y-3 rounded-xl border p-4">
        <h2 className="font-semibold">3. Frames disponíveis</h2>

        <div className="grid grid-cols-4 gap-2 sm:grid-cols-6 md:grid-cols-8">
          {frames.map((frame, index) => (
            <button
              key={frame.id}
              className={`rounded-lg border p-2 ${
                selected === index ? "border-primary ring-2 ring-primary" : ""
              }`}
              onClick={() => {
                setPlaying(false);
                setSelected(index);
              }}
            >
              <img
                src={frame.url}
                alt={`Frame ${index + 1}`}
                className="mx-auto h-12 w-12 object-contain"
                style={{ imageRendering: "pixelated" }}
              />
              <span className="text-xs">#{index + 1}</span>
            </button>
          ))}
        </div>

        <input
          ref={frameInput}
          hidden
          type="file"
          accept="image/*"
          onChange={(e) => {
            replaceFrame(e.target.files?.[0]);
            e.currentTarget.value = "";
          }}
        />

        <div className="flex flex-wrap gap-2">
          <button
            className="rounded-lg border px-3 py-2"
            disabled={!currentFrame}
            onClick={() => frameInput.current?.click()}
          >
            Substituir frame
          </button>

          <button
            className="rounded-lg bg-primary px-3 py-2 text-primary-foreground"
            disabled={!frames.length}
            onClick={exportSheet}
          >
            Exportar PNG
          </button>
        </div>
      </section>

      <p role="status" className="rounded-lg bg-muted p-3 text-sm">
        {message}
      </p>

      <p className="text-xs text-muted-foreground">
        Esta versão trabalha com imagens PNG. Ela ainda não importa nem grava
        gráficos, paletas ou animações diretamente em arquivos ROM .gba.
      </p>
    </main>
  );
}
